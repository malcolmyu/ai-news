{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://number-two.local/contracts/daily-digest.schema.json",
  "title": "DailyDigest",
  "type": "object",
  "required": ["date", "title", "sections"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["kind", "title", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builders", "podcasts", "github", "news", "analysis"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["title", "summary"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "builder": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "required": ["src", "width", "height", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
