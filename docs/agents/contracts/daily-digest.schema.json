{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://number-two.local/contracts/daily-digest.schema.json",
  "title": "DailyDigest",
  "type": "object",
  "required": ["date", "title", "sections"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "heroLabel": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stat"
      }
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["kind", "title", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builders", "podcasts", "github", "news", "analysis"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "footnote": {
          "type": "string"
        },
        "layout": {
          "type": "string",
          "enum": ["vitem", "tweet", "simple", "card", "highlights", "prose", "rss", "embed"]
        },
        "intro": {
          "type": "string"
        },
        "embedUrl": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["title", "summary"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "builder": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        },
        "tweetId": {
          "type": "string"
        },
        "tweetDate": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "forks": {
          "type": "integer",
          "minimum": 0
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "repoName": {
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "galleryCols": {
          "type": "integer",
          "enum": [2, 3]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "url": {
          "type": "string"
        },
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaAsset"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "favorites": {
          "type": "integer",
          "minimum": 0
        },
        "retweets": {
          "type": "integer",
          "minimum": 0
        },
        "replies": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "required": ["src", "width", "height", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "stat": {
      "type": "object",
      "required": ["num", "label"],
      "additionalProperties": false,
      "properties": {
        "num": {
          "type": ["integer", "string"]
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
