{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://number-two.local/contracts/research-report.schema.json",
  "title": "ResearchReport",
  "type": "object",
  "required": ["slug", "title", "date", "summary", "sections"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagram"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["title", "path"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["mermaid", "html", "image"]
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
