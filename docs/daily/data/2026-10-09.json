    {
      "kind": "podcasts",
      "layout": "embed",
      "label": "深度对话",
      "title": "Every：为何从个人 Agent 转向公司共享 Agent",
      "intro": "Every 的 Dan Shipper 与平台负责人 Willie Williams 在 10 月 7 日的访谈中回顾团队 Agent 的迭代。以下是他们对自身组织的经验，不代表所有团队都应采用同一架构。",
      "embedUrl": "https://www.youtube-nocookie.com/embed/_pcy1_jU27k",
      "items": [
        {
          "title": "个人 Agent 的维护成本会累积",
          "summary": "团队最初让成员各自运行 Agent；随着底层变化、设备故障和工具更替，许多人不愿持续维护自己的实例。这促使 Every 转向更统一的工作入口。"
        },
        {
          "title": "共享上下文更适合协作流程",
          "summary": "Williams 认为，公司 Agent 能随团队使用逐渐积累流程知识；个人 Agent 则需要反复补齐组织上下文。访谈同时保留个人生活场景对个性化 Agent 的需求。"
        },
        {
          "title": "先有稳定底座，再按团队分化",
          "summary": "Shipper 设想共享 Agent 继续存在，并在专门需求出现时分化成团队 Agent。这是其产品判断，组织规模、权限和维护能力仍会影响选择。",
          "links": [
            {
              "label": "观看原视频 →",
              "url": "https://www.youtube.com/watch?v=_pcy1_jU27k"
            },
            {
              "label": "阅读逐字稿 →",
              "url": "https://every.to/podcast/transcript-why-every-traded-personal-agents-for-one-company-agent"
            }
          ]
        }
      ]
    },
