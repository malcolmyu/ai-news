      "items": [
        {
          "title": "Anthropic 把模型安全能力交给防御者",
          "summary": "Anthropic 于 10 月 8 日公布 Cyber Mission，首批工作面向关键基础设施和开源软件。关键基础设施计划由合作服务商参与，开源项目可自愿申请定期扫描；落地仍依赖维护者验证、定级和修复。",
          "links": [
            {
              "label": "阅读官方计划 →",
              "url": "https://www.anthropic.com/news/anthropic-cyber-mission"
            }
          ]
        },
        {
          "title": "Google 让游戏创作从文字描述开始",
          "summary": "Google Labs 的 Playground 允许用户描述、试玩并分享游戏，现阶段是实验平台，仅向美国 18 岁以上用户开放。文章称 Unity Spark 的进一步集成仍在测试，不能当作已经上线的完整游戏开发工具。",
          "links": [
            {
              "label": "阅读官方发布 →",
              "url": "https://blog.google/innovation-and-ai/technology/ai/playground-experimental-gaming-platform/"
            }
          ]
        }
      ]
