{
  "name": "ai-news-daily",
  "description": "Generate AI daily news digest with Chinese translation, beautiful UI, and full content summarization",
  "version": "1.1.0",
  "repository": "https://github.com/malcolmyu/ai-news",
  "author": "AI News Team",
  "keywords": ["news", "rss", "ai", "summarization", "automation", "chinese"],
  "categories": ["automation", "data-processing", "reporting"],
  "requirements": {
    "python": ">=3.7",
    "dependencies": [
      "feedparser>=6.0.11",
      "requests>=2.31.0",
      "beautifulsoup4>=4.12.2",
      "openai>=1.54.0",
      "jinja2>=3.1.2",
      "pyyaml>=6.0.1",
      "python-dotenv>=1.0.0",
      "lxml>=6.0.2",
      "markdown>=3.5.1",
      "tenacity>=8.0.0"
    ],
    "environment_variables": [
      {
        "name": "OPENROUTER_API_KEY",
        "description": "OpenRouter API key for AI summarization",
        "required": true
      },
      {
        "name": "OPENROUTER_BASE_URL",
        "description": "OpenRouter API base URL",
        "default": "https://openrouter.ai/api/v1"
      },
      {
        "name": "OPENROUTER_MODEL",
        "description": "AI model for summarization",
        "default": "anthropic/claude-3-sonnet"
      }
    ]
  },
  "usage": {
    "command": "python src/main.py",
    "arguments": [
      {
        "name": "--date",
        "description": "Generate news for specific date (YYYY-MM-DD)",
        "example": "--date 2026-03-25"
      },
      {
        "name": "--no-summarize",
        "description": "Skip AI summarization (faster)"
      },
      {
        "name": "--verbose",
        "description": "Enable detailed logging"
      },
      {
        "name": "--output",
        "description": "Custom output directory",
        "example": "--output /path/to/output"
      },
      {
        "name": "--config",
        "description": "Custom config file path",
        "example": "--config custom/config.yaml"
      }
    ]
  },
  "output": {
    "type": "html",
    "location": "output/ai-news-YYYY-MM-DD.html",
    "description": "Formatted HTML report with summarized articles organized by category"
  },
  "limitations": [
    "Each RSS source limited to max 3 articles",
    "Each HTML source limited to max 2 articles",
    "Only fetches articles from last 3 days by default",
    "Requires OpenRouter API key for summarization"
  ]
}
