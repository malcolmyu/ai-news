{
  "name": "growth-website-system",
  "version": "1.0.0",
  "description": "基于 Agent-Team 架构的个人自主成长网站系统",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npx babel src --out-dir dist --extensions .ts,.tsx --copy-files && tsc --noEmit",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "daily": "npm run build && node dist/main.js daily",
    "homepage": "npm run build && node dist/main.js homepage",
    "research": "npm run build && node dist/main.js research",
    "thinking": "npm run build && node dist/main.js thinking",
    "stats": "npm run build && node dist/main.js stats",
    "git-push": "npm run build && node dist/main.js git-push",
    "all": "npm run build && node dist/main.js all",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:watch": "node --test --watch dist/test/**/*.test.js"
  },
  "keywords": [
    "ai",
    "typescript",
    "automation",
    "news",
    "growth"
  ],
  "author": "AI News System",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.0.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.0",
    "feedparser": "^0.10.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.0.0",
    "marked": "^12.0.0",
    "openai": "^4.0.0",
    "playwright": "^1.58.2",
    "solid-js": "^1.9.12",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "babel-preset-solid": "^1.9.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
